# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads.gate.lock
.beads/proxieddb/


# Added by cargo
/target

# pact runtime state. NOT .pact/events.jsonl or .pact/messages.jsonl — those are
# the append-only history behind `pact log` and `pact msg`, and both are meant to
# be committed (see docs/architecture.md). Read cursors are not: see below.
.pact/leases/
.pact/waits/
# One file per agent, id -> when they read it. Local because a read position is
# per-machine; committing it would have every clone inherit peers' read state.
.pact/read/

# Generated agent-workflow scripts (.claude/settings.json is tracked)
.claude/workflows/

tmp/*

# Everything pact or an agent writes under .pact/ is local runtime state,
# EXCEPT the two append-only logs below, which are history and belong in git.
.pact/*
!.pact/events.jsonl
!.pact/messages.jsonl

antithesis
.claude/skills/*
