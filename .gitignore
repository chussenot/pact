# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/


# Added by cargo
/target

# pact runtime state. NOT .pact/events.jsonl — that is the append-only
# history behind `pact log`, and it is meant to be committed
# (see docs/architecture.md).
.pact/leases/
.pact/waits/

# Generated agent-workflow scripts (.claude/settings.json is tracked)
.claude/workflows/

tmp/*

# Everything pact or an agent writes under .pact/ is local runtime state,
# EXCEPT the append-only event log, which is history and belongs in git.
.pact/*
!.pact/events.jsonl

antithesis
